---
import Layout from '../../layouts/Layout.astro';
import Tile from '../../components/Tile.astro';
import { formatUsd, isLocale } from '../../i18n/locales';
import { fill, strings, type Strings } from '../../i18n/strings';
import ProductCard from '../../components/ProductCard.astro';
import { catalog, MAX_QUANTITY, type Product } from '../../lib/shop';
import { brandCopy, brandOf, brandPath, findBrand } from '../../content/brands';
import { cacheCatalog } from '../../lib/http';
import { SITE_NAME, SITE_URL } from '../../lib/site';

const { locale, slug } = Astro.params;
if (!isLocale(locale) || !slug) return Astro.rewrite('/404');
// Brand landing pages share this URL shape with localized slugs: /tr/steam-cuzdan-kodu, /de/steam-guthaben, ...
const brandPage = findBrand(locale, slug);
if (brandPage?.exact) return Astro.rewrite(`/${locale}/brand/${brandPage.key}`);
if (brandPage) return Astro.redirect(`/${locale}${brandPath(brandPage.key, locale)}`, 301);
const t = strings(locale);

let item: Product | null;
let all: Product[] = [];
try {
  all = await catalog();
  item = all.find((p) => p.slug === slug) ?? null;
} catch {
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
  item = null;
}
const missing = item === null && Astro.response.status !== 503;
if (missing) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'public, max-age=60');
}
if (item) cacheCatalog(Astro.response.headers);

// ?error=<code> comes back from /api/checkout when the order could not be started.
const errorCode = Astro.url.searchParams.get('error');
const added = Astro.url.searchParams.get('added') === '1';
const errorKey = `err_${errorCode}` as keyof Strings;
const error = errorCode ? (t[errorKey] ?? t.err_generic) : null;

const brand = item ? brandOf(item) : null;
const brandInfo = brand ? brandCopy(brand, locale) : null;
const related = item && brand ? all.filter((p) => p.slug !== item.slug && brandOf(p) === brand).slice(0, 8) : [];

const title = item ? fill(t.productTitle, { title: item.title }) : `${missing ? t.notFound : t.catalogDown} | ${SITE_NAME}`;
const description = item ? fill(t.productDesc, { title: item.title }) : missing ? t.notFoundText : t.catalogDown;
const jsonLd = item
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'Product',
        name: item.title,
        ...(item.family || brandInfo ? { brand: { '@type': 'Brand', name: item.family ?? brandInfo!.copy.name } } : {}),
        category: 'Digital gift cards',
        sku: item.slug,
        description,
        offers: {
          '@type': 'Offer',
          url: `${SITE_URL}/${locale}/${item.slug}`,
          priceCurrency: 'USD',
          price: item.price.toFixed(2),
          availability: item.inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
          seller: { '@type': 'Organization', name: SITE_NAME },
        },
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: t.home, item: `${SITE_URL}/${locale}` },
          ...(brand && brandInfo ? [{ '@type': 'ListItem', position: 2, name: brandInfo.copy.name, item: `${SITE_URL}/${locale}${brandPath(brand, locale)}` }] : []),
          { '@type': 'ListItem', position: brand ? 3 : 2, name: item.title, item: `${SITE_URL}/${locale}/${item.slug}` },
        ],
      },
    ]
  : [];
---

<Layout locale={locale} title={title} description={description} path={`/${slug}`} noindex={!item} jsonLd={jsonLd}>
  {
    !item && (
      <section class="wrap narrow center page-pad">
        {missing && <h1>{t.notFound}</h1>}
        <p class="empty">{missing ? t.notFoundText : t.catalogDown}</p>
        <a class="btn" href={`/${locale}`}>{t.newOrder}</a>
      </section>
    )
  }
  {
    item && (
      <div class="wrap page-pad">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href={`/${locale}`}>{t.home}</a>
          <span aria-hidden="true">/</span>
          {brand && brandInfo && (
            <>
              <a href={`/${locale}${brandPath(brand, locale)}`}>{brandInfo.copy.name}</a>
              <span aria-hidden="true">/</span>
            </>
          )}
          <span aria-current="page">{item.title}</span>
        </nav>
        <div class="product">
          <div class="product-head">
            <Tile name={item.family ?? item.title} size="large" />
            <div>
              {item.family && <p class="eyebrow">{item.family}</p>}
              <h1>{item.title}</h1>
              <p class="product-price">
                <strong>{formatUsd(item.price, locale)}</strong>
                <span class:list={['stock', { out: !item.inStock }]}>{item.inStock ? t.inStock : t.outOfStock}</span>
              </p>
              <p class="muted small">{t.priceNote}</p>
            </div>
          </div>

          <form class="panel buy" method="POST" action="/api/cart">
            <input type="hidden" name="slug" value={item.slug} />
            <input type="hidden" name="locale" value={locale} />
            <input type="hidden" name="back" value={`/${locale}/${item.slug}`} />
            {added && (
              <p class="notice-ok" role="status">
                {t.added} <a href={`/${locale}/cart`}>{t.goToCart} →</a>
              </p>
            )}
            {error && <p class="alert" role="alert">{error}</p>}
            <div class="field">
              <label for="qty">{t.quantity}</label>
              <div class="stepper" data-stepper>
                <button type="button" data-step="-1" aria-label={t.decrease} disabled={!item.inStock}>−</button>
                <input id="qty" name="quantity" type="number" inputmode="numeric" min="1" max={MAX_QUANTITY} value="1" disabled={!item.inStock} />
                <button type="button" data-step="1" aria-label={t.increase} disabled={!item.inStock}>+</button>
              </div>
            </div>
            <div class="buy-actions">
              <button class="btn btn-lg" type="submit" name="action" value="buy" disabled={!item.inStock}>
                {item.inStock ? t.buyNow : t.outOfStock}
              </button>
              <button class="btn btn-lg btn-ghost" type="submit" name="action" value="add" disabled={!item.inStock}>{t.addToCart}</button>
            </div>
            <p class="muted small">{t.cartLimits}</p>
            <ol class="mini-steps">
              <li>{t.how1Title}</li>
              <li>{t.how2Title}</li>
              <li>{t.how3Title}</li>
            </ol>
          </form>
        </div>

        {brand && brandInfo && (
          <div class="brand-info" lang={brandInfo.lang !== locale ? 'en' : undefined} dir={brandInfo.lang !== locale ? 'ltr' : undefined}>
            <section class="panel">
              <h2>{brandInfo.copy.regionTitle}</h2>
              {brandInfo.copy.region.map((p) => <p>{p}</p>)}
            </section>
            <section class="panel">
              <h2>{brandInfo.copy.redeemTitle}</h2>
              <ol class="redeem">
                {brandInfo.copy.redeemSteps.map((step) => <li>{step}</li>)}
              </ol>
            </section>
          </div>
        )}

        {brand && brandInfo && (
          <section class="section-tight">
            <div class="section-head">
              <h2>{fill(t.moreFrom, { name: brandInfo.copy.name })}</h2>
              <a href={`/${locale}${brandPath(brand, locale)}`}>{fill(t.allOf, { name: brandInfo.copy.name })} →</a>
            </div>
            {related.length > 0 && (
              <div class="grid">
                {related.map((p) => (
                  <ProductCard item={p} locale={locale} />
                ))}
              </div>
            )}
          </section>
        )}
      </div>
    )
  }
</Layout>

<script>
  // Quantity stepper: − / + buttons around a number input (works without JS as a plain input).
  document.querySelectorAll<HTMLElement>('[data-stepper]').forEach((stepper) => {
    const input = stepper.querySelector('input')!;
    stepper.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((button) =>
      button.addEventListener('click', () => {
        const next = Math.min(Number(input.max) || 20, Math.max(Number(input.min) || 1, (Number(input.value) || 1) + Number(button.dataset.step)));
        input.value = String(next);
      }),
    );
  });
</script>
