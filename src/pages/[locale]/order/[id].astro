---
import QRCode from 'qrcode';
import Layout from '../../../layouts/Layout.astro';
import { formatUsd, isLocale } from '../../../i18n/locales';
import { fill, strings, type Strings } from '../../../i18n/strings';
import { getCheckout, type Checkout } from '../../../lib/shop';
import { noStore } from '../../../lib/http';
import { SITE_NAME, SUPPORT_EMAIL } from '../../../lib/site';

const { locale, id } = Astro.params;
if (!isLocale(locale) || !id) return Astro.rewrite('/404');
const t = strings(locale);
noStore(Astro.response.headers);

const token = Astro.url.searchParams.get('t') ?? '';
let order: Checkout | null = null;
let down = false;
try {
  order = token ? await getCheckout(id, token) : null;
} catch {
  down = true;
}
if (!order) Astro.response.status = down ? 503 : 404;

const topup = order?.kind === 'TOPUP';
const fromBalance = order?.paymentMethod === 'BALANCE';
const awaiting = order?.status === 'AWAITING_PAYMENT' && !fromBalance && Boolean(order?.payTo && order?.amount);
const qr = order && awaiting ? await QRCode.toString(order.payTo!, { type: 'svg', margin: 1, errorCorrectionLevel: 'M' }) : '';
// A top-up ends at APPROVED (credited); an order ends at DELIVERED.
const done = order ? (topup ? order.status === 'APPROVED' : order.status === 'DELIVERED') : false;
const statusLabel = !order ? '' : topup && order.status === 'APPROVED' ? t.status_CREDITED : t[`status_${order.status}` as keyof Strings];
const statusText = !order
  ? ''
  : topup && order.status === 'APPROVED'
    ? t.text_CREDITED
    : topup && order.status === 'PAID'
      ? t.text_TOPUP_PAID
      : fromBalance && order.status === 'PAID'
        ? t.paidFromBalance
        : fill(t[`text_${order.status}` as keyof Strings], { email: order.email });
const open = order && !done && ['AWAITING_PAYMENT', 'PAID', 'APPROVED'].includes(order.status);
const tone = !order ? '' : done ? 'ok' : ['REJECTED', 'EXPIRED'].includes(order.status) ? 'bad' : 'wait';
const heading = order ? (topup ? t.topupOrderTitle : order.title) : '';
---

<Layout locale={locale} title={order ? `${fill(t.orderTitle, { number: order.number })} | ${SITE_NAME}` : `${t.notFound} | ${SITE_NAME}`} description={t.homeDesc} path="" noindex>
  <section class="wrap narrow page-pad">
    {
      !order && (
        <div class="center">
          <h1>{down ? t.err_generic : t.notFound}</h1>
          <p class="muted">{down ? t.catalogDown : t.notFoundText}</p>
          <a class="btn" href={`/${locale}`}>{t.newOrder}</a>
        </div>
      )
    }
    {
      order && (
        <div class="order" data-id={order.id} data-token={order.token} data-status={order.status} data-open={open ? '1' : ''}>
          <p class="eyebrow">{heading}</p>
          <h1>{fill(t.orderTitle, { number: order.number })}</h1>
          <p class:list={['status-pill', tone]}>{statusLabel}</p>
          <p class="lead">{statusText}</p>

          {awaiting && (
            <div class="panel pay">
              <div class="fee-warning" role="alert">
                <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M12 2 1 21h22L12 2Zm0 4.2L19.5 19h-15L12 6.2ZM11 10v5h2v-5h-2Zm0 6v2h2v-2h-2Z"/></svg>
                <div>
                  <strong>{t.feeTitle}</strong>
                  <p>{fill(t.feeText, { amount: order.amount! })}</p>
                </div>
              </div>
              <div class="pay-grid">
                <div class="qr" set:html={qr} />
                <dl class="pay-lines">
                  <div>
                    <dt>{t.amount}</dt>
                    <dd>
                      <code class="big" dir="ltr">{order.amount} {order.asset}</code>
                      <button class="copy" type="button" data-copy={order.amount} data-done={t.copied}>{t.copy}</button>
                    </dd>
                  </div>
                  <div>
                    <dt>{t.network}</dt>
                    <dd><span class="net-badge" dir="ltr">{order.asset} · {order.networkLabel}</span></dd>
                  </div>
                  <div>
                    <dt>{t.address}</dt>
                    <dd>
                      <code class="addr" dir="ltr">{order.payTo}</code>
                      <button class="copy" type="button" data-copy={order.payTo} data-done={t.copied}>{t.copy}</button>
                    </dd>
                  </div>
                </dl>
              </div>
              <p class="alert">{fill(t.exactWarning, { network: order.networkLabel! })}</p>
              <p class="countdown">
                <span id="countdown" data-expires={order.expiresAt} data-template={t.timeLeft} />
              </p>
            </div>
          )}

          {order.lines.length > 0 && (
            <table class="lines">
              <caption class="sr-only">{t.items}</caption>
              <tbody>
                {order.lines.map((line) => (
                  <tr>
                    <td>{line.title}</td>
                    <td class="num">{line.quantity} × {formatUsd(line.unitPrice, locale)}</td>
                    <td class="num">{formatUsd(line.quantity * line.unitPrice, locale)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
          <dl class="summary">
            <div><dt>{topup ? t.topupOrderTitle : t.total}</dt><dd><strong>{formatUsd(order.total, locale)}</strong></dd></div>
            <div><dt>{t.orderEmail}</dt><dd>{order.email}</dd></div>
          </dl>
          {open && !fromBalance && <p class="muted small">{t.autoRefresh}</p>}
          <p class="muted small">{t.keepLink}</p>
          <p class="muted small">{t.contact}: <a href={`mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent(`Order ${order.number}`)}`}>{SUPPORT_EMAIL}</a></p>
        </div>
      )
    }
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        const label = button.textContent;
        button.textContent = button.dataset.done ?? '✓';
        setTimeout(() => (button.textContent = label), 1500);
      } catch {
        /* clipboard blocked: the text is still selectable */
      }
    });
  });

  const countdown = document.querySelector<HTMLElement>('#countdown');
  if (countdown) {
    const end = Date.parse(countdown.dataset.expires ?? '');
    const tick = () => {
      const left = Math.max(0, end - Date.now());
      const m = Math.floor(left / 60000);
      const s = Math.floor((left % 60000) / 1000);
      countdown.textContent = (countdown.dataset.template ?? '{time}').replace('{time}', `${m}:${String(s).padStart(2, '0')}`);
    };
    tick();
    setInterval(tick, 1000);
  }

  // While the order is open, ask for its status and reload when it changes.
  const order = document.querySelector<HTMLElement>('.order[data-open="1"]');
  if (order) {
    const url = `/api/order/${encodeURIComponent(order.dataset.id ?? '')}?t=${encodeURIComponent(order.dataset.token ?? '')}`;
    const poll = async () => {
      if (document.visibilityState !== 'visible') return;
      try {
        const response = await fetch(url, { cache: 'no-store' });
        if (!response.ok) return;
        const { status } = (await response.json()) as { status?: string };
        if (status && status !== order.dataset.status) location.reload();
      } catch {
        /* try again next time */
      }
    };
    setInterval(poll, 15000);
    document.addEventListener('visibilitychange', poll);
  }
</script>
