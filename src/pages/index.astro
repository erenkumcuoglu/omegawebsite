---
import { pickLocale } from '../i18n/locales';

// "/" sends visitors to their language; search engines see hreflang on every language page.
const locale = pickLocale(Astro.request.headers.get('accept-language'));
return new Response(null, {
  status: 302,
  headers: { Location: `/${locale}`, Vary: 'Accept-Language', 'Cache-Control': 'public, max-age=0, must-revalidate' },
});
---
