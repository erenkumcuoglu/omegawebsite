---
import '../styles/global.css';
import { LOCALES, LOCALE_INFO, DEFAULT_LOCALE, type Locale } from '../i18n/locales';
import { strings } from '../i18n/strings';
import { SITE_NAME, SITE_URL, SUPPORT_EMAIL } from '../lib/site';
import { BRAND_KEYS, brandCopy, brandPath } from '../content/brands';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path after the locale, e.g. "" for home or "/pubg-mobile-60-uc". */
  path: string;
  /** Pages per buyer (orders) or errors: kept out of search and without language links. */
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** Languages this page really exists in (hreflang); default all. */
  locales?: readonly Locale[];
  /** Per-language path when it differs by language (brand pages with localized slugs). */
  paths?: Partial<Record<Locale, string>>;
}

const { locale, title, description, path, noindex = false, jsonLd = [], locales = LOCALES, paths = {} } = Astro.props;
const t = strings(locale);
const info = LOCALE_INFO[locale];
const pathFor = (l: Locale) => paths[l] ?? path;
const urlFor = (l: Locale) => `${SITE_URL}/${l}${pathFor(l)}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={info.hreflang} dir={info.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={urlFor(locale)} />
          {locales.map((l) => <link rel="alternate" hreflang={LOCALE_INFO[l].hreflang} href={urlFor(l)} />)}
          {locales.includes(DEFAULT_LOCALE) && <link rel="alternate" hreflang="x-default" href={urlFor(DEFAULT_LOCALE)} />}
        </>
      )
    }
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={info.og} />
    {!noindex && <meta property="og:url" content={urlFor(locale)} />}
    <meta property="og:image" content={`${SITE_URL}/omega-logo.png`} />
    <meta name="theme-color" content="#d91557" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="logo" href={`/${locale}`} aria-label={`${SITE_NAME} — ${t.home}`}>
          <img src="/omega-logo.png" alt={SITE_NAME} width="140" height="38" />
        </a>
        <nav class="main-nav" aria-label={t.navCatalog}>
          <a href={`/${locale}#catalog`}>{t.navCatalog}</a>
          <a href={`/${locale}#how`}>{t.navHow}</a>
          <a href={`/${locale}#faq`}>{t.navFaq}</a>
          <a href="#support">{t.navSupport}</a>
        </nav>
        <div class="header-actions">
        {/* Account (balance) and cart links will go here when the Omega API offers them. */}
        <details class="lang">
          <summary aria-label={`${t.language}: ${locale.toUpperCase()}`}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.9 6h-3a15.7 15.7 0 0 0-1.4-3.6A8 8 0 0 1 18.9 8ZM12 4c.8 1.2 1.5 2.5 1.9 4h-3.8c.4-1.5 1.1-2.8 1.9-4ZM4.3 14a8 8 0 0 1 0-4h3.4a16.5 16.5 0 0 0 0 4H4.3Zm.8 2h3a15.7 15.7 0 0 0 1.4 3.6A8 8 0 0 1 5.1 16Zm3-8h-3a8 8 0 0 1 4.4-3.6C8 5.6 7.6 6.8 8.1 8ZM12 20c-.8-1.2-1.5-2.5-1.9-4h3.8c-.4 1.5-1.1 2.8-1.9 4Zm2.3-6H9.7a14.7 14.7 0 0 1 0-4h4.6a14.7 14.7 0 0 1 0 4Zm.3 5.6c.6-1.1 1.1-2.3 1.4-3.6h3a8 8 0 0 1-4.4 3.6Zm1.7-5.6a16.5 16.5 0 0 0 0-4h3.4a8 8 0 0 1 0 4h-3.4Z"/></svg>
            <span>{locale.toUpperCase()}</span>
          </summary>
          <ul>
            {
              LOCALES.map((l) => (
                <li>
                  <a href={noindex ? `/${l}` : `/${l}${pathFor(l)}`} hreflang={LOCALE_INFO[l].hreflang} lang={LOCALE_INFO[l].hreflang} aria-current={l === locale ? 'true' : undefined}>
                    {LOCALE_INFO[l].name}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <img src="/omega-logo.png" alt={SITE_NAME} width="140" height="38" loading="lazy" />
          <p class="muted">{t.footerAbout}</p>
          <p><a href={`/${locale}/terms`}>{t.terms}</a> · <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></p>
        </div>
        <nav aria-label={t.brands}>
          <h2 class="footer-title">{t.brands}</h2>
          <ul class="footer-links">
            {BRAND_KEYS.map((key) => (
              <li><a href={`/${locale}${brandPath(key, locale)}`}>{brandCopy(key, locale).copy.name}</a></li>
            ))}
          </ul>
        </nav>
        <form id="support" class="support" name="support" method="POST" action="/__forms.html" data-sent={t.supportSent} data-failed={t.supportFailed}>
          <h2>{t.supportTitle}</h2>
          <p class="muted">{t.supportText}</p>
          <input type="hidden" name="form-name" value="support" />
          <input type="hidden" name="locale" value={locale} />
          <p hidden><label>Leave empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <label class="field"><span>{t.supportEmail}</span><input name="email" type="email" required autocomplete="email" /></label>
          <label class="field"><span>{t.supportMessage}</span><textarea name="message" rows="3" required></textarea></label>
          <button class="btn" type="submit">{t.supportSend}</button>
          <p class="notice" role="status" hidden></p>
        </form>
      </div>
      <div class="wrap footer-bar">© {year} {SITE_NAME}. {t.rights}</div>
    </footer>

    <script>
      const form = document.querySelector<HTMLFormElement>('#support');
      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const notice = form.querySelector<HTMLElement>('.notice')!;
        const button = form.querySelector('button')!;
        button.disabled = true;
        try {
          const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
          const response = await fetch('/__forms.html', { method: 'POST', headers: { 'content-type': 'application/x-www-form-urlencoded' }, body });
          if (!response.ok) throw new Error(String(response.status));
          form.reset();
          notice.textContent = form.dataset.sent ?? '';
        } catch {
          notice.textContent = form.dataset.failed ?? '';
        } finally {
          notice.hidden = false;
          button.disabled = false;
        }
      });
      // Close the language menu when clicking elsewhere.
      document.addEventListener('click', (event) => {
        document.querySelectorAll<HTMLDetailsElement>('details.lang[open]').forEach((menu) => {
          if (!menu.contains(event.target as Node)) menu.open = false;
        });
      });
    </script>
  </body>
</html>
